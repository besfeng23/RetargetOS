{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@repo/db": ["packages/db/index.ts"],
      "@repo/queue": ["packages/queue/index.ts"],
      "@repo/consent": ["packages/consent/index.ts"],
      "@repo/events": ["packages/events/index.ts"],
      "@repo/audiences": ["packages/audiences/index.ts"],
      "@repo/identity": ["packages/identity/index.ts"],
      "@repo/connectors": ["packages/connectors/index.ts"],
      "@repo/ai": ["packages/ai/index.ts"],
      "@repo/monetization": ["packages/monetization/index.ts"]
    }
  }
}