{
  "name": "@repo/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./schema": "./schema/index.ts",
    "./client": "./client.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "db:push": "drizzle-kit push:pg --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit generate:pg --config ./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "14.2.35",
    "postgres": "^3.4.0",
    "turbo": "2.9.16"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.3.3"
  }
}
