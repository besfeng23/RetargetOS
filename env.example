# IMPORTANT: This file documents required environment variables.
# NEVER commit actual secrets here. Use GitHub Secrets instead.

# ============================================
# FRONTEND / PUBLIC KEYS (Safe to expose)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SB_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_RETARGETOS_FUNCTION_BASE_URL=https://your-project.supabase.co/functions/v1
NEXT_PUBLIC_RETARGETOS_DEFAULT_REPO=https://github.com/besfeng23/RetargetOS

# ============================================
# BACKEND / SECRET KEYS (NEVER expose in frontend)
# ============================================
# DO NOT PREFIX THESE WITH NEXT_PUBLIC!
# These should only be available in:
#   - .env.local (local development)
#   - GitHub Secrets (CI/CD)
#   - Server-side environment variables (production)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SB_SECRET_KEY=sb_secret_your_key_here

# ============================================
# OPTIONAL: Deployment/CI Configuration
# ============================================
# VERCEL_TOKEN=your_vercel_token_here (set as GitHub Secret, not here)
